# Copy this file to ".env.local" and fill in your own keys.
# .env.local is gitignored, so your secrets never get committed.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers -> API keys) ---
# Only the SECRET key is used (checkout redirects server-side to Stripe's
# hosted page; no publishable key needed). Must be a full sk_ key — a
# restricted rk_ key is rejected and disables payments entirely.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Second webhook endpoint at the SAME URL but for "events on Connected
# accounts" (account.updated / account.application.deauthorized). A Stripe
# endpoint delivers platform events OR Connect events, never both, and each
# endpoint signs with its own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Groq (for AI descriptions + photo checks; free tier is fine) ---
GROQ_API_KEY=

# --- Resend (transactional email; verify a domain to send to real users) ---
RESEND_API_KEY=
EMAIL_FROM=ForkFork <onboarding@resend.dev>

# --- Admin console access (comma-separated emails allowed at /admin) ---
ADMIN_EMAILS=

# --- App (in production set this to the canonical URL: https://forkfork.app) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Order-reminder cron (a random string; must match the CRON_SECRET GitHub
# Actions secret used by .github/workflows/order-reminders.yml) ---
CRON_SECRET=

# Product analytics (PostHog) — optional; analytics is a no-op if unset.
# Create a free project at posthog.com, then set the Project API Key here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
